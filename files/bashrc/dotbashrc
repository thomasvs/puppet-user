# .bashrc

# User specific aliases and functions

alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

add_to_path_front() {
  case ":$PATH:" in
    *":$1:"*) ;; # already present
    *) PATH="$1:$PATH" ;;
  esac
}

if [ -d "$HOME/.local/bin" ] ; then
    add_to_path_front "$HOME/.local/bin"
fi
if [ -d "$HOME/bin" ] ; then
    add_to_path_front "$HOME/bin"
fi
export PATH

# thomas: customization
if test -e ~/.bashrc.d
then
  for f in ~/.bashrc.d/*
  do
    source $f
  done
fi

PS1="\$(parse_git_branch)$PS1"
