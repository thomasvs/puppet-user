# .bash_profile
# when this exists, /etc/skel/.profile does not get read by bash

# Get the aliases and functions
if [ -f ~/.bashrc ]; then
	. ~/.bashrc
fi

add_to_path_front() {
  case ":$PATH:" in
    *":$1:"*) ;; # already present
    *) PATH="$1:$PATH" ;;
  esac
}

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
    add_to_path_front "$HOME/bin"
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
    add_to_path_front "$HOME/.local/bin"
fi
export PATH
# customization
if test -d ~/.bash_profile.d
then
  files=$(shopt -s nullglob dotglob; echo ~/.bash_profile.d/*)
  if (( ${#files} ))
  then
    for f in ${files}
    do
      source $f
    done
  fi
fi
